{
  "name": "globes",
  "private": true,
  "version": "0.1.0",
  "description": "Glass globes of water, simulated live on the GPU with WebGPU and three.js",
  "license": "MIT",
  "author": "Will Waltz",
  "homepage": "https://globes-nine.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/willwaltz/globes.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "electron .",
    "web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && GLOBES_DIST=1 electron .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "@webgpu/types": "^0.1.74",
    "electron": "^44.7.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "main": "electron/main.mjs"
}
